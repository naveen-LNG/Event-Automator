{
  "name": "event-automation-desktop",
  "version": "1.16.1",
  "description": "Standalone desktop version of the SkipBo Event Automation Tool (no Unity Editor, no Python install required).",
  "main": "main.js",
  "author": "SkipBo Event Automation",
  "scripts": {
    "postinstall": "git config core.hooksPath githooks",
    "prestart": "npm run sync:py",
    "start": "electron .",
    "sync:py": "powershell -ExecutionPolicy Bypass -File scripts/sync-pybackend.ps1",
    "build:py": "powershell -ExecutionPolicy Bypass -File scripts/build-pybackend.ps1",
    "build:icon": "python scripts/make-icon.py",
    "check:drift": "powershell -ExecutionPolicy Bypass -File scripts/check-drift.ps1",
    "test": "node tests/ui_contract_test.js && node tests/sprint_ui_test.js && npm run test:py",
    "test:py": "pybackend_dist\\python\\python.exe pybackend_dist/python/test_interpreter_resolve.py && pybackend_dist\\python\\python.exe pybackend_dist/python/test_chapter_core.py",
    "dist": "npm run build:py && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.skipbo.eventautomator",
    "productName": "Event Automator",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "!pybackend_dist/**"
    ],
    "extraResources": [
      {
        "from": "pybackend_dist/python",
        "to": "pybackend"
      },
      {
        "from": "ideationData",
        "to": "ideationData"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Event Automator",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
